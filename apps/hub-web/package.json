{
  "name": "@monster-agent-hub/hub-web",
  "version": "0.0.0",
  "private": true,
  "description": "Tablet-friendly interface for Monster Agent Hub.",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit --pretty false && vite build",
    "dev": "vite",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@ibm/plex-mono-variable": "1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
